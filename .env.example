# TravelPay Environment Configuration

# Application
APP_NAME=TravelPay
APP_ENV=development
TEST_MODE=true
DEBUG=true

# Database (Use sqlite for local dev, postgresql for docker/prod)
DATABASE_URL=sqlite:///./travelpay.db
# DATABASE_URL=postgresql://travelpay:travelpay_secret@localhost:5432/travelpay_db

# Security
SECRET_KEY=travelpay-ultra-secure-jwt-secret-key-32chars-min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PAN_ENCRYPTION_KEY=

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_TravelPayKey01
RAZORPAY_KEY_SECRET=rzp_test_TravelPaySecret01
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_travelpay_test

# Fee & Compliance
MARKUP_PERCENT=2.0
GST_PERCENT=18.0
LRS_ANNUAL_LIMIT_USD=250000.00
DEFAULT_PER_TXN_LIMIT_INR=200000.00
DEFAULT_DAILY_LIMIT_INR=500000.00

# Pluggable Providers
OTP_PROVIDER=console       # console, twilio, msg91
SETTLEMENT_PROVIDER=sandbox # sandbox, wise, airwallex
KYC_PROVIDER=sandbox       # sandbox, hyperverge, idfy

# Twilio (Production SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (Production Indian SMS OTP)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# Wise Platform (Production Settlement)
WISE_API_KEY=
WISE_PROFILE_ID=

# Airwallex (Production Settlement)
AIRWALLEX_API_KEY=
AIRWALLEX_CLIENT_ID=

